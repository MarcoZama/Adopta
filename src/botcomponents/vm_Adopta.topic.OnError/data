kind: AdaptiveDialog
startBehavior: UseLatestPublishedContentAndCancelOtherTopics
beginDialog:
  kind: OnError
  id: main
  actions:
    - kind: SetVariable
      id: setVariable_timestamp
      variable: init:Topic.CurrentTime
      value: =Text(Now(), DateTimeFormat.UTC)

    - kind: ConditionGroup
      id: condition_1
      conditions:
        - id: bL4wmY
          condition: =System.Conversation.InTestMode = true
          actions:
            - kind: SendActivity
              id: sendMessage_XJBYMo
              activity: |-
                Messaggio di errore: {System.Error.Message}
                Codice errore: {System.Error.Code}
                ID conversazione: {System.Conversation.Id}
                Ora (UTC): {Topic.CurrentTime}

      elseActions:
        - kind: ConditionGroup
          id: communicationError
          conditions:
            - id: explainingFailed
              condition: =Global.CommunicationExplaining = true
              actions:
                - kind: SendActivity
                  id: explanationError
                  activity: "{If(Global.CommunicationEnglish, \"The documentation search failed, so I cannot provide a verified explanation. No other communication was selected. You can try again later.\", \"La ricerca nella documentazione non è riuscita: non posso fornire un approfondimento verificato. Non è stata selezionata un'altra comunicazione. Puoi riprovare più tardi.\")}"
          elseActions:
            - kind: SendActivity
              id: sendMessage_dZ0gaF
              activity:
                text:
                  - |-
                    {If(Text(Global.UserLanguage) = "en", "Something went wrong.", "Si è verificato un errore.")}
                    {If(Text(Global.UserLanguage) = "en", "Error code", "Codice errore")}: {System.Error.Code}
                    {If(Text(Global.UserLanguage) = "en", "Conversation ID", "ID conversazione")}: {System.Conversation.Id}
                    {If(Text(Global.UserLanguage) = "en", "Time (UTC)", "Ora (UTC)")}: {Topic.CurrentTime}.
                speak:
                  - |-
                    {If(Text(Global.UserLanguage) = "en", "Something went wrong. Please try again.", "Si è verificato un errore. Riprova.")}

    - kind: SetVariable
      id: resetExplaining
      variable: Global.CommunicationExplaining
      value: =false

    - kind: LogCustomTelemetryEvent
      id: 9KwEAn
      eventName: OnErrorLog
      properties: "={ErrorMessage: System.Error.Message, ErrorCode: System.Error.Code, TimeUTC: Topic.CurrentTime, ConversationId: System.Conversation.Id}"

    - kind: CancelAllDialogs
      id: NW7NyY