kind: AdaptiveDialog
startBehavior: CancelOtherTopics
beginDialog:
  kind: OnSystemRedirect
  id: main
  actions:
    - kind: Question
      id: 41d42054-d4cb-4e90-b922-2b16b37fe379
      conversationOutcome: ResolvedImplied
      alwaysPrompt: true
      variable: init:Topic.SurveyResponse
      prompt: |-
        {If(Text(Global.UserLanguage) = "en", "Did I answer your question?", "Ho risposto alla tua domanda?")}
      entity: BooleanPrebuiltEntity

    - kind: ConditionGroup
      id: condition-0
      conditions:
        - id: condition-0-item-0
          condition: =Topic.SurveyResponse = true
          actions:
            - kind: CSATQuestion
              id: csat_1
              conversationOutcome: ResolvedConfirmed

            - kind: SendActivity
              id: sendMessage_8r29O0
              activity: |-
                {If(Text(Global.UserLanguage) = "en", "Thanks for your feedback.", "Grazie per il feedback.")}

            - kind: Question
              id: question_1
              alwaysPrompt: true
              variable: init:Topic.Continue
              prompt: |-
                {If(Text(Global.UserLanguage) = "en", "Can I help you with anything else?", "Posso aiutarti con altro?")}
              entity: BooleanPrebuiltEntity

            - kind: ConditionGroup
              id: condition-1
              conditions:
                - id: condition-1-item-0
                  condition: =Topic.Continue = true
                  actions:
                    - kind: SendActivity
                      id: sendMessage_4eOE6h
                      activity: |-
                        {If(Text(Global.UserLanguage) = "en", "Go ahead. I'm listening.", "Continua. Sono in attesa.")}

              elseActions:
                - kind: SendActivity
                  id: yHBz55
                  activity: |-
                    {If(Text(Global.UserLanguage) = "en", "OK, see you soon.", "OK, a presto.")}

                - kind: EndConversation
                  id: jh1GMT

      elseActions:
        - kind: Question
          id: PM68ot
          alwaysPrompt: true
          variable: init:Topic.TryAgain
          prompt: |-
            {If(Text(Global.UserLanguage) = "en", "Sorry I couldn't help. Do you want to try again?", "Mi dispiace di non essere riuscito ad aiutarti. Vuoi riprovare?")}
          entity: BooleanPrebuiltEntity

        - kind: ConditionGroup
          id: KNxYBf
          conditions:
            - id: DPveFP
              condition: =Topic.TryAgain = false
              actions:
                - kind: BeginDialog
                  id: cngqi4
                  dialog: vm_Adopta.topic.Escalate

          elseActions:
            - kind: SendActivity
              id: GrVHEW
              activity: |-
                {If(Text(Global.UserLanguage) = "en", "Go ahead. I'm listening.", "Continua. Sono in attesa.")}