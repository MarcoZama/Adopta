kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: Ricomincia
    includeInOnSelectIntent: false
    triggerQueries:
      - cominciamo di nuovo
      - ricominciamo
      - iniziamo di nuovo
      - inizia di nuovo
      - start over
      - let's start again
      - restart

  actions:
    - kind: Question
      id: question_zguoVV
      alwaysPrompt: false
      variable: init:Topic.Confirm
      prompt: |-
        {If(Text(Global.UserLanguage) = "en", "Do you want to start over?", "Riavviare la conversazione?")}
      entity: BooleanPrebuiltEntity

    - kind: ConditionGroup
      id: conditionGroup_lvx2zV
      conditions:
        - id: conditionItem_sVQtHa
          condition: =Topic.Confirm = true
          actions:
            - kind: BeginDialog
              id: 0YKYsy
              dialog: vm_Adopta.topic.ResetConversation

      elseActions:
        - kind: SendActivity
          id: sendMessage_lk2CyQ
          activity: |-
            {If(Text(Global.UserLanguage) = "en", "OK. Let's carry on.", "Ok. Andiamo avanti.")}