kind: AdaptiveDialog
beginDialog:
  kind: OnActivity
  id: main
  priority: 5
  condition: =StartsWith(System.Activity.Text, "Adopta.Communication.v2|") || StartsWith(System.Activity.Text, "Dimmi di più sulla comunicazione «") || StartsWith(System.Activity.Text, "Tell me more about the communication «")
  type: Message
  actions:
    - kind: SetVariable
      id: versioned
      variable: Topic.Versioned
      value: =StartsWith(System.Activity.Text, "Adopta.Communication.v2|")

    - kind: SetVariable
      id: parts
      variable: Topic.Parts
      value: =Split(System.Activity.Text, "|")

    - kind: SetVariable
      id: english
      variable: Topic.English
      value: =If(Topic.Versioned, CountRows(Topic.Parts) = 3 && Text(Index(Topic.Parts, 2).Value) = "en", StartsWith(System.Activity.Text, "Tell me more about the communication «"))

    - kind: SetVariable
      id: prefix
      variable: Topic.Prefix
      value: =If(Topic.English, "Tell me more about the communication «", "Dimmi di più sulla comunicazione «")

    - kind: SetVariable
      id: titleEnd
      variable: Topic.TitleEnd
      value: |-
        =If(!Topic.Versioned, If(EndsWith(System.Activity.Text, "»"), Len(System.Activity.Text), Find("»: ", System.Activity.Text)), Blank())

    - kind: ConditionGroup
      id: validReference
      conditions:
        - id: validCard
          condition: =If(Topic.Versioned, CountRows(Topic.Parts) = 3 && (Text(Index(Topic.Parts, 2).Value) = "it" || Text(Index(Topic.Parts, 2).Value) = "en") && IsMatch(Text(Index(Topic.Parts, 3).Value), "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"), !IsBlank(Topic.TitleEnd) && Topic.TitleEnd > Len(Topic.Prefix) + 1)
          actions:
            - kind: SendActivity
              id: waiting
              activity: "{If(Topic.English, \"One moment, I'm preparing your answer...\", \"Un attimo, sto preparando la risposta...\")}"

            - kind: BeginDialog
              id: resolveCard
              dialog: vm_Adopta.topic.RisolviComunicazione
              input:
                binding:
                  Mode: =If(Topic.Versioned, "id", "title")
                  CommunicationId: =If(Topic.Versioned, Text(Index(Topic.Parts, 3).Value), "")
                  Title: =If(Topic.Versioned, "", Trim(Mid(System.Activity.Text, Len(Topic.Prefix) + 1, Topic.TitleEnd - Len(Topic.Prefix) - 1)))
                  Link: =If(!Topic.Versioned && Topic.TitleEnd < Len(System.Activity.Text), Trim(Mid(System.Activity.Text, Topic.TitleEnd + 3)), "")
                  MatchLink: =!Topic.Versioned
                  Request: =If(Topic.English, "Explain this communication, how to use the feature and its documented prerequisites.", "Spiega questa comunicazione, come si usa la funzionalità e i prerequisiti documentati.")
                  English: =Topic.English
                  ConfirmLatest: =false

      elseActions:
        - kind: SendActivity
          id: invalidReference
          activity: "{If(Topic.English, \"I cannot interpret this card's reference. Ask about a communication by its complete title; I have not selected another message.\", \"Non riesco a interpretare il riferimento della card. Indicami il titolo completo della comunicazione: non ho selezionato un altro messaggio.\")}"

    - kind: CancelAllDialogs
      id: finish

inputType: {}
outputType: {}
